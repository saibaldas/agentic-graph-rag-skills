OPENAI_API_KEY=sk-your-key-here

# Observability switch: which backend the notebooks report to (restart the kernel after changing).
#   phoenix  -> Arize Phoenix UI http://localhost:6006      stack: docker-compose/docker-compose.phoenix.yml   (Neo4j on 7688)
#   deepeval -> local DeepEval   http://localhost:8765      stack: docker-compose/docker-compose.deepeval.yml  (Neo4j on 7689)
#   both     -> both of the above (notebooks use the Phoenix Neo4j)
#   none     -> no observability (same as notebooks_advanced; uses the original Neo4j on 7687)
# Start commands (from the repo root) are in notebooks_advanced_with_observability/README.md.
OBSERVABILITY_BACKEND=phoenix
# DEEPEVAL_MAX_CASES=6        # how many judged answers DeepEval re-scores at the end of a notebook
# DEEPEVAL_MODEL=gpt-4o-mini  # DeepEval's judge model (read by the Docker container)

# Optional overrides (defaults shown). NEO4J_URI defaults to the Neo4j of the chosen backend (7688 / 7689 / 7687).
# OPENAI_LLM_MODEL=gpt-4o
# OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_EMBED_DIM=3072
# NEO4J_URI=bolt://localhost:7688
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
